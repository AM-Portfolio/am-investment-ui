modules = ["dart-3.8", "flutter"]

[nix]
channel = "stable-25_05"
packages = ["flutter"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Flutter Web App"

[[workflows.workflow]]
name = "Flutter Web App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "$HOME/.pub-cache/bin/dhttpd --host=0.0.0.0 --port=5000 --path=build/web"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33701
externalPort = 3003

[[ports]]
localPort = 35777
externalPort = 3002

[[ports]]
localPort = 38287
externalPort = 3000

[[ports]]
localPort = 45787
externalPort = 3001

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "$HOME/.pub-cache/bin/dhttpd --host=0.0.0.0 --port=5000 --path=build/web"]
build = ["flutter", "build", "web", "--release"]
